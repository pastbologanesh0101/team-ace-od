# Supabase — server-side only (the app never talks to Supabase from the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # "Secret" key from Project Settings -> API Keys

# Random 32+ byte hex string. Signs session cookies. Rotating it signs everyone out.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Admin login passcode — keep private
ADMIN_PASSCODE=change-me-admin
